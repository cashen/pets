{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pets",
  "compatibility_date": "2026-09-30",
  "routes": [
    {
      "pattern": "montpets.com",
      "custom_domain": true
    },
    {
      "pattern": "www.montpets.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page"
  }
}