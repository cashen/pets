/*
 * Cloudflare Pages cache policy
 *
 * HTML stays revalidatable so releases become visible immediately.
 * Versioned static assets are immutable and can remain at the edge/browser
 * for one year without risking stale deployments.
 */
/
  Cache-Control: public, max-age=0, must-revalidate

/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable
